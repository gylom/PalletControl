{
  "ConnectionStrings": {
    "Default": "Data Source=palletcontrol-v5.db"
  },
  "Jwt": {
    "Issuer": "PalletControl",
    "Audience": "PalletControl",
    "LifetimeMinutes": 21600
  },
  "AllowedHosts": "paller.transportservice.no;localhost;127.0.0.1",
  "Database": {
    "BackupDirectory": "Backups",
    "BackupIntervalHours": 24,
    "BackupRetentionDays": 30
  },
  "Security": {
    "MaxRequestBodyMb": 20,
    "ApiRequestsPerMinute": 600,
    "LoginRequestsPerMinute": 10,
    "LoginFailureLimit": 5,
    "LoginLockoutMinutes": 15,
    "AllowedOrigins": []
  },
  "BootstrapAdmin": {
    "Username": "superadmin",
    "DisplayName": "Super Administrator"
  },
  "OpenTelemetry": {
    "ServiceName": "PalletControl.Api",
    "OtlpEndpoint": ""
  },
  "ReceivedControlEmail": {
    "Enabled": true,
    "Host": "transportservice-no.mail.protection.outlook.com",
    "Port": 25,
    "From": "gytis@transportservice.no",
    "Recipients": {
      "SRD": "arbeidsledere.sfd@transportservice.no",
      "ARE": "arbeidsledere.are@transportservice.no",
      "KRS": "arbeidsledere.krs@transportservice.no"
    },
    "ReceivedControlEmail": {
      "Enabled": false,
      "Host": "transportservice-no.mail.protection.outlook.com",
      "Port": 25,
      "From": "gytis@transportservice.no",
      "Recipients": {
        "SRD": "arbeidsledere.sfd@transportservice.no",
        "ARE": "arbeidsledere.are@transportservice.no",
